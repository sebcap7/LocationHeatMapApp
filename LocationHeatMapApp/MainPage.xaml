<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LocationHeatMapApp.MainPage"
    Title="Location Heat Map">

    <Grid
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        Padding="12"
        RowSpacing="10">

        <Label
            Grid.Row="0"
            Text="Location Heat Map Tracker"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

        <Button
            Grid.Row="1"
            x:Name="SaveLocationButton"
            Text="Save Current Location"
            Clicked="OnSaveLocationClicked"
            HorizontalOptions="Fill"
            BackgroundColor="#512BD4"
            TextColor="White"
            CornerRadius="8" />

        <Label
            Grid.Row="2"
            Text="Saved Location Heat Map"
            FontSize="17"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

        <Border
            Grid.Row="3"
            Stroke="#808080"
            StrokeThickness="1"
            BackgroundColor="#F5F5F5"
            Padding="4"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <Image
                Source="heatmap.png"
                Aspect="AspectFit"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

        </Border>

        <Label
            Grid.Row="4"
            x:Name="StatusLabel"
            Text="Select Save Current Location to begin tracking."
            FontSize="14"
            TextColor="Gray"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

    </Grid>

</ContentPage>